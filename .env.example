# PostgreSQL (password is set only on first volume init — see README troubleshooting)
POSTGRES_USER=shortener
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shortener
POSTGRES_PORT=5432

# API (used for local dev outside Docker)
DATABASE_URL=postgresql+psycopg://shortener:change-me@localhost:5432/shortener

# Web
WEB_PORT=3000
FASTAPI_INTERNAL_URL=http://api:8000

# Optional: protect create/delete endpoints (leave empty to disable)
ADMIN_API_KEY=

# Optional: send API key from browser when ADMIN_API_KEY is set (exposes key to clients)
NEXT_PUBLIC_API_KEY=

# Rate limiting (set false for local dev/tests)
RATE_LIMIT_ENABLED=true
